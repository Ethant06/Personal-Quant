# Database — Supabase session pooler
user=postgres.YOUR_PROJECT_REF
password=YOUR_DB_PASSWORD
host=aws-1-YOUR_REGION.pooler.supabase.com
port=5432
dbname=postgres

# Auth — Project Settings → API Keys (new publishable key)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional legacy alias (old "anon" JWT key). Prefer SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_ANON_KEY=eyJ...

# Do NOT put SUPABASE_SECRET_KEY (sb_secret_...) here unless you later need
# admin/service operations. It is NOT the JWT signing secret.
